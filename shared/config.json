{
  "cleanup": {
    "messagesURL": "https://api.anthropic.com/v1/messages",
    "model": "claude-opus-5-5",
    "apiVersion": "2026-10-21",
    "fallbackBeta": "server-side-fallback-2026-07-01",
    "effort": "low",
    "maxTokens": 4096,
    "minChunkWords": 40,
    "maxChunkWords": 150,
    "contextWords": 30,
    "requestTimeoutSeconds": 20,
    "finishTimeoutSeconds": 7
  },
  "deepgram": {
    "listenURL": "wss://api.deepgram.com/v1/listen",
    "model": "nova-3",
    "languages": {
      "english": "en",
      "german": "de"
    },
    "finalizeTimeoutSeconds": 3
  },
  "screen": {
    "maxCharacters": 3000,
    "maxKeyterms": 30,
    "maxElements": 1500,
    "readTimeoutSeconds": 0.25
  }
}
